# Copy to .env.local. Every service is optional; a service with no credentials shows as not configured.

# --- App ---
# Public URL of this instance. Builds the OAuth redirect URIs. Use 127.0.0.1 locally (Spotify rejects localhost).
APP_URL=http://127.0.0.1:3000
# 32+ random characters that encrypt the session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=
# Set to 1 to replace every service with in-memory fakes (local dev and E2E). Never in production.
MOCK_PROVIDERS=

# --- Spotify (docs/setup-spotify.md) ---
# Client ID for logging in. Leave empty to require users to bring their own.
SPOTIFY_CLIENT_ID=
# Only for no-login search (Client Credentials). Login uses PKCE and never needs it.
SPOTIFY_CLIENT_SECRET=

# --- Apple Music (docs/setup-apple-music.md, needs the $99/yr Apple Developer Program) ---
# 10-character Team ID from Membership details.
APPLE_TEAM_ID=
# 10-character ID of the MusicKit key.
APPLE_KEY_ID=
# Contents of the .p8 key. Newlines can be written as \n.
APPLE_PRIVATE_KEY=

# --- YouTube Music (docs/setup-youtube-music.md) ---
# OAuth client (Web application) for connecting accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional API key restricted to YouTube Data API v3, for no-login search.
YOUTUBE_API_KEY=
