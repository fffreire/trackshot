# Spotify app Client ID (https://developer.spotify.com/dashboard). Leave empty to require users to bring their own.
SPOTIFY_CLIENT_ID=
# Only used for the no-login "copy links" search mode (Client Credentials flow). Optional.
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI on your Spotify app. Spotify rejects "localhost"; use 127.0.0.1.
APP_URL=http://127.0.0.1:3000
# 32+ random characters, used to encrypt the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=
